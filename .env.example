# =================================================================
# Code Flow Visualizer - Environment Configuration (.env.example)
# Copy this file to '.env' to customize your local settings.
# Default settings work out-of-the-box with $0 cost and no API keys!
# =================================================================

# AI Explainer Provider
# Options: rule_based (default, offline & instant), groq, ollama
AI_PROVIDER=rule_based

# Optional: Groq API Key (only needed if AI_PROVIDER=groq)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=

# Optional: Ollama Host (only needed if AI_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434

# Execution Safeguards
MAX_STEPS=1000
TIMEOUT_SEC=4.0

# Frontend API URL (Used by Vite dev server if configured)
VITE_API_BASE_URL=http://localhost:8000/api

# Admin & Analytics Configuration
ADMIN_SECRET_KEY=codelearner-admin-2026

# Optional: Custom Database & Uploads Directory (defaults to backend/data/)
DATABASE_PATH=
UPLOAD_DIR=
