# =================================================================
# TRACELAP Code Flow Visualizer - Environment Configuration (.env.example)
# Copy this file to '.env' to customize your local or cloud settings.
# Default settings work out-of-the-box with $0 cost and zero setup!
# =================================================================

# AI Explainer Provider
# Options: rule_based (default, offline & instant), groq, ollama
AI_PROVIDER=rule_based

# Optional: Groq API Key (only needed if AI_PROVIDER=groq)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=

# Optional: Ollama Host (only needed if AI_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434

# Execution Safeguards
MAX_STEPS=1000
TIMEOUT_SEC=4.0

# Frontend API URL (Used by Vite dev server if configured)
VITE_API_BASE_URL=http://localhost:8000/api

# Admin Dashboard Secret Key
ADMIN_SECRET_KEY=tracelap

# =================================================================
# Persistent Database & Storage Configuration (Zero Data Loss)
# =================================================================
# MongoDB Atlas (Recommended for cloud deployments like Vercel / Render / AWS):
# Provide your connection string below to automatically store all genuine
# feedbacks and analytics events in MongoDB Atlas cloud database.
# Example: 
MONGODB_URI=mongodb+srv://vardhanbabuvendi:vardhanbabuvendi@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=tracelap

# Local Storage (Fallback):
# If MONGODB_URI is empty, TRACELAP uses local SQLite with WAL mode +
# automatic append-only JSONL backups in backend/data/backups/
DATABASE_PATH=
UPLOAD_DIR=
